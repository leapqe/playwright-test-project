{
  "name": "playwright-test-project",
  "version": "1.0.0",
  "description": "Technical Test for QE candidates - Playwright UI and API automation",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --project=ui",
    "test:api": "npx playwright test --project=api",
    "report": "npx playwright show-report",
    "lint": "npx eslint --ext .ts ."
  },
  "keywords": [
    "playwright",
    "qe",
    "technical-test",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^8.57.1",
    "eslint-plugin-playwright": "^1.3.1",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "dotenv": "^16.4.7",
    "env-cmd": "^10.1.0"
  }
}
